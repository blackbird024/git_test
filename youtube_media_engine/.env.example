# Copia este fichero a .env (que NO se sube a git) o define las variables en la configuración del entorno.
# Ninguna es necesaria para las etapas actuales: el sistema funciona en local con 0 $.

# YouTube Data API v3 (clave gratuita de Google Cloud): investigación de competencia y tendencias.
YOUTUBE_API_KEY=
# OAuth para subir vídeos (siempre en privado) y leer YouTube Analytics. Ruta al JSON de cliente OAuth.
YOUTUBE_OAUTH_CLIENT_SECRETS=
# Proveedores opcionales de pago (solo con autorización explícita):
ELEVENLABS_API_KEY=
