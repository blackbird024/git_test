//@version=6
// ─────────────────────────────────────────────────────────────────────────────────────────────
// Ruptura del rango de ayer (NQ / MNQ, sesión regular de NY) — mismas reglas que alpaca/nq_intraday_research.py (pdr)
//   1. Rango de ayer = máximo y mínimo de la sesión regular de ayer (9:30-16:00 NY).
//   2. Hoy, si la sesión abre DENTRO de ese rango:
//        el precio supera el máximo de ayer → largo en ese nivel; pierde el mínimo → corto en ese nivel.
//   3. Stop en el punto medio del rango de ayer. Sin objetivo: se cierra a las 16:00 NY.
//   4. Una operación por día; no se entra después de las 15:30 NY.
// Backtest NQ 2018-2026 (1 MNQ, coste 1 punto): ~90 operaciones/año, 50 % de acierto,
// 2023-2026 +2.700 $/año, PF 1,31; 7 de 9 años positivos (2021: −1.700 $). En ES no funciona.
// Práctico: al abrir NY pon dos órdenes STOP (compra en el máximo de ayer, venta en el mínimo) y cancela la otra al entrar.
// ─────────────────────────────────────────────────────────────────────────────────────────────
indicator("Ruptura del rango de ayer", "Rango ayer", overlay = true, scale = scale.right, max_labels_count = 300, max_lines_count = 300)

TZ        = "America/New_York"
sessRth   = input.session("0930-1600", "Sesión regular (NY)")
lastEntry = input.int(1530, "Última entrada (HHMM, NY)", minval = 930, maxval = 1555)
showPanel = input.bool(true, "Panel")
colHi     = input.color(#C9CED6, "Máximo de ayer")
colLo     = input.color(#6A84A3, "Mínimo de ayer")
colMid    = input.color(#A89A5B, "Punto medio (stop)")

fmt(float x) => str.tostring(x, format.mintick)

inRth    = not na(time(timeframe.period, sessRth, TZ))
rthStart = inRth and not inRth[1]
rthEnd   = not inRth and inRth[1]
hm       = hour(time, TZ) * 100 + minute(time, TZ)

// ── rango de la sesión regular (el de hoy se convierte en "ayer" al abrir la siguiente)
var float curH = na
var float curL = na
var float pdh = na
var float pdl = na
var float mid = na

// ── estado del día
var int    pos = 0          // 1 largo, -1 corto, 0 fuera
var float  entry = na
var bool   done = false
var string st = "—"

if rthStart
    pdh := curH
    pdl := curL
    mid := (pdh + pdl) / 2
    curH := high
    curL := low
    pos := 0
    entry := na
    done := false
    if na(pdh)
        st := "sin rango de ayer"
        done := true
    else if open > pdh or open < pdl
        st := "abrió fuera del rango: hoy no se opera"
        done := true
    else
        st := "esperando ruptura"
        alert("Rango de ayer · " + syminfo.ticker + " · COMPRA STOP " + fmt(pdh) + " · VENTA STOP " + fmt(pdl) + " · stop en " + fmt(mid)
          + " · riesgo " + fmt(pdh - mid) + " pts (" + str.tostring((pdh - mid) * 2, "#") + " $ por MNQ) · cierre a las 16:00 NY", alert.freq_once_per_bar)
else if inRth
    curH := math.max(curH, high)
    curL := math.min(curL, low)

// ── gestión (solo con la vela cerrada; las órdenes reales serían STOP en el nivel)
if barstate.isconfirmed and inRth and not na(pdh)
    // salida: stop en el medio (desde la vela siguiente a la entrada) o cierre de la sesión
    if pos != 0
        hitStop = pos == 1 ? low <= mid : high >= mid
        lastBar = hour(time_close, TZ) * 100 + minute(time_close, TZ) >= 1600   // última vela de la sesión, en cualquier temporalidad
        if hitStop or lastBar
            px = hitStop ? mid : close
            res = pos * (px - entry)
            label.new(bar_index, px, (hitStop ? "STOP " : "CIERRE ") + (res >= 0 ? "+" : "") + fmt(res) + " pts", color = color.new(color.black, 100),
              textcolor = res >= 0 ? color.new(color.green, 10) : color.new(color.red, 10), size = size.small,
              style = pos == 1 ? label.style_label_up : label.style_label_down)
            alert("Rango de ayer · " + syminfo.ticker + " · " + (hitStop ? "STOP" : "cierre 16:00") + " · " + (res >= 0 ? "+" : "") + fmt(res) + " pts", alert.freq_once_per_bar_close)
            st := (hitStop ? "stop" : "cerrado a las 16:00") + " · " + (res >= 0 ? "+" : "") + fmt(res) + " pts"
            pos := 0
            done := true
    // entrada: ruptura del máximo o del mínimo de ayer (primero el máximo si la vela toca los dos)
    else if not done and hm <= lastEntry
        side = high > pdh ? 1 : low < pdl ? -1 : 0
        if side != 0
            pos := side
            entry := side == 1 ? pdh : pdl
            st := (side == 1 ? "LARGO" : "CORTO") + " desde " + fmt(entry)
            label.new(bar_index, entry, (side == 1 ? "▲ LARGO " : "▼ CORTO ") + fmt(entry), color = side == 1 ? colHi : colLo, textcolor = color.black,
              size = size.small, style = side == 1 ? label.style_label_up : label.style_label_down,
              tooltip = "Stop en el medio: " + fmt(mid) + "\nRiesgo: " + fmt(math.abs(entry - mid)) + " pts = " + str.tostring(math.abs(entry - mid) * 2, "#") + " $ por MNQ\nSalida a las 16:00 NY")
            alert("Rango de ayer · " + syminfo.ticker + " · " + (side == 1 ? "LARGO" : "CORTO") + " en " + fmt(entry) + " · stop " + fmt(mid), alert.freq_once_per_bar_close)
            // si la misma vela de entrada ya cerró al otro lado del medio, el stop se revisa en la siguiente (como el backtest)

// ── niveles (plots: siempre visibles, se cortan entre días)
brk(float x) => x != x[1] ? float(na) : x
bH = brk(pdh)
bL = brk(pdl)
bM = brk(mid)
plot(inRth ? bH : na, "Máximo de ayer", colHi, 2, plot.style_linebr)
plot(inRth ? bL : na, "Mínimo de ayer", colLo, 2, plot.style_linebr)
plot(inRth ? bM : na, "Medio (stop)", colMid, 1, plot.style_linebr)

// ── panel
var table pnl = table.new(position.top_right, 2, 5, bgcolor = color.new(#0D1117, 10), border_color = color.new(color.gray, 80), border_width = 1)
row(int r, string a, string b) =>
    pnl.cell(0, r, a, text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
    pnl.cell(1, r, b, text_color = color.white, text_size = size.small, text_halign = text.align_left)
if showPanel and barstate.islast
    row(0, "Compra stop", na(pdh) ? "—" : fmt(pdh))
    row(1, "Venta stop", na(pdl) ? "—" : fmt(pdl))
    row(2, "Stop (medio)", na(mid) ? "—" : fmt(mid))
    row(3, "Riesgo 1 MNQ", na(pdh) ? "—" : fmt(pdh - mid) + " pts · " + str.tostring((pdh - mid) * 2, "#") + " $")
    row(4, "Hoy", st)
