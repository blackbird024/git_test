//@version=6
// Bandas de ruido de NY para MNQ — mismas reglas que alpaca/mnq_intraday_lab.py (estrategia "noise").
// Basado en "Beat the Market" (Zarattini, Aziz, Barbon 2024).
// Backtest NQ 2018-2026, 1 MNQ y costes incluidos: ~12 operaciones/mes, 45 % de acierto, +2.800-3.000 $/año, 8 de 9 años positivos.
//
//   1. Para cada hora de la sesión, el "ruido" es el movimiento medio desde la apertura (en %) de los últimos 14 días.
//   2. Banda superior = max(apertura de hoy, cierre de ayer) × (1 + ruido); inferior = min(...) × (1 − ruido).
//   3. Solo se decide al cierre de cada media hora (10:00, 10:30 ... 15:30 NY), o cada 15 minutos si se elige:
//        cierre por encima de la banda superior → COMPRA; por debajo de la inferior → VENTA.
//        Si estás dentro y el cierre vuelve dentro de la banda → SALIR (y si sale por el otro lado, entrar al revés).
//   4. Lo que siga abierto se cierra a las 16:00 NY (22:00 en Italia).
// Usar en NQ1! o MNQ1!, gráfico de 5 minutos (también vale 1, 3, 10 o 15 minutos).
indicator("Bandas de ruido NY", "Ruido NY", overlay = true, max_labels_count = 500)

TZ = "America/New_York"

lookback = input.int(14, "Días para medir el ruido", minval = 5)
every    = input.int(30, "Revisar cada (minutos)", options = [15, 30, 60],
                     tooltip = "Backtest NQ 2018-2026 (1 MNQ): cada 30 min ≈ 17 entradas/mes, +2.900 $/año; cada 15 min ≈ 24 entradas/mes, +2.300 $/año y drawdown algo menor")
bandMult = input.float(1.0, "Multiplicador de la banda", step = 0.1)
useVwap  = input.bool(false, "Salida también si cruza el VWAP de la sesión", tooltip = "El backtest sin VWAP dio igual o mejor")
showFill = input.bool(true, "Sombrear la zona de ruido")
showInfo = input.bool(true, "Panel de estado")

// ── temporalidad
tfMin   = timeframe.isminutes ? timeframe.multiplier : 0
tfOk    = tfMin > 0 and 390 % tfMin == 0 and every % tfMin == 0
nCols   = tfOk ? int(390 / tfMin) : 1

// ── sesión regular
inRth   = not na(time(timeframe.period, "0930-1600", TZ))
mins    = hour(time, TZ) * 60 + minute(time, TZ)
endMins = mins + tfMin
newDay  = inRth and not inRth[1]
k       = int(math.floor((mins - 570) / tfMin))

var matrix<float> hist = matrix.new<float>(lookback, math.max(nCols, 1), na)
var array<float> today = array.new<float>(math.max(nCols, 1), na)
var int   slot      = 0
var int   filled    = 0
var int   barsToday = 0
var float dayOpen   = na
var float prevClose = na
var float lastRth   = na
var float pv        = 0.0
var float vv        = 0.0

if tfOk and newDay
    if barsToday == nCols                                          // solo días completos, como el backtest
        for c = 0 to nCols - 1
            hist.set(slot, c, today.get(c))
        slot   := (slot + 1) % lookback
        filled := math.min(filled + 1, lookback)
    today.fill(na)
    barsToday := 0
    prevClose := lastRth
    dayOpen   := open
    pv := 0.0
    vv := 0.0

float ub = na
float lb = na
float vwap = na
if tfOk and inRth and k >= 0 and k < nCols
    today.set(k, math.abs(close / dayOpen - 1))
    barsToday += 1
    lastRth := close
    pv += hlc3 * nz(volume)
    vv += nz(volume)
    vwap := vv > 0 ? pv / vv : na
    if filled >= lookback and not na(prevClose)
        float s = 0.0
        int   n = 0
        for r = 0 to lookback - 1
            v = hist.get(r, k)
            if not na(v)
                s += v
                n += 1
        sigma = n > 0 ? s / n * bandMult : na
        ub := math.max(dayOpen, prevClose) * (1 + sigma)
        lb := math.min(dayOpen, prevClose) * (1 - sigma)

pU = plot(ub, "Banda superior", color.teal, 2, plot.style_linebr)
pL = plot(lb, "Banda inferior", color.red, 2, plot.style_linebr)
fill(pU, pL, showFill ? color.new(color.gray, 90) : na, "Zona de ruido")

// ── decisiones cada media hora
var int pos = 0
isCheck = tfOk and inRth and not na(ub) and (endMins - 570) % every == 0 and endMins >= 570 + every and endMins < 960
isLast  = tfOk and inRth and endMins == 960

fmt(float x) => str.tostring(x, format.mintick)
hhmm(int m, int shift) => str.tostring((int(math.floor(m / 60)) + shift) % 24) + ":" + str.tostring(m % 60, "00")
note(string txt, color col, bool up) =>
    label.new(bar_index, up ? low : high, txt, color = col, textcolor = color.white, size = size.small,
              style = up ? label.style_label_up : label.style_label_down)

if isCheck
    exitLong  = pos == 1 and close < (useVwap and not na(vwap) ? math.max(ub, vwap) : ub)
    exitShort = pos == -1 and close > (useVwap and not na(vwap) ? math.min(lb, vwap) : lb)
    if exitLong or exitShort
        note("⬜ SALIR " + (pos == 1 ? "largo" : "corto"), color.gray, pos == -1)
        alert("Bandas de ruido: SALIR del " + (pos == 1 ? "largo" : "corto") + " en " + syminfo.ticker + " a " + fmt(close),
              alert.freq_once_per_bar_close)
        pos := 0
    if pos == 0 and close > ub
        pos := 1
        note("🟢 COMPRA\n" + fmt(close), color.new(color.green, 10), true)
        alert("Bandas de ruido: COMPRA en " + syminfo.ticker + " a " + fmt(close) + " (banda " + fmt(ub) + ")",
              alert.freq_once_per_bar_close)
    else if pos == 0 and close < lb
        pos := -1
        note("🔴 VENTA\n" + fmt(close), color.new(color.red, 10), false)
        alert("Bandas de ruido: VENTA en " + syminfo.ticker + " a " + fmt(close) + " (banda " + fmt(lb) + ")",
              alert.freq_once_per_bar_close)

if isLast and pos != 0
    note("🔔 CERRAR 16:00", color.orange, pos == -1)
    alert("Bandas de ruido: CERRAR la posición en " + syminfo.ticker + " (16:00 NY)", alert.freq_once_per_bar_close)
    pos := 0
if newDay
    pos := 0

// ── panel
var table info = table.new(position.top_right, 2, 4, bgcolor = color.new(color.black, 20), border_width = 1)
if showInfo and barstate.islast
    if not tfOk
        info.cell(0, 0, "⚠️ Usa un gráfico de 1, 3, 5, 10 o 15 minutos", text_color = color.orange)
    else
        lastCheck = 570 + int(math.floor(385 / every)) * every
        nextCheck = endMins < 570 + every ? 570 + every : math.min(lastCheck, (int(math.floor((endMins - 570) / every)) + 1) * every + 570)
        info.cell(0, 0, "Posición", text_color = color.white)
        info.cell(1, 0, pos == 1 ? "🟢 LARGO" : pos == -1 ? "🔴 CORTO" : "⬜ FUERA", text_color = color.white)
        info.cell(0, 1, "Próxima revisión", text_color = color.white)
        info.cell(1, 1, inRth and endMins < lastCheck ? hhmm(int(nextCheck), 0) + " NY · " + hhmm(int(nextCheck), 6) + " Italia" : hhmm(570 + every, 0) + " NY · " + hhmm(570 + every, 6) + " Italia",
                  text_color = color.white)
        info.cell(0, 2, "Bandas", text_color = color.white)
        info.cell(1, 2, na(ub) ? (filled < lookback ? "calentando " + str.tostring(filled) + "/" + str.tostring(lookback) + " días" : "fuera de sesión")
                  : fmt(lb) + " – " + fmt(ub), text_color = color.white)
        info.cell(0, 3, "Tamaño", text_color = color.white)
        info.cell(1, 3, "1 MNQ (Apex 50k)", text_color = color.white)
