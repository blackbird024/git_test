//@version=6
// Swing highs y lows para el Modelo de Confirmación (mismas reglas que confirmation_model_backtest.py).
// Usar en gráfico de 5 minutos. Un swing high es una vela cuyo máximo es el más alto de las 3 velas
// a cada lado (se confirma 3 velas después). La línea sigue viva hasta que el precio la barre
// o pasan 48 velas (4 horas). Cuando se barre, se marca "barrido" y salta una alerta.
indicator("Swings 5m – Modelo de Confirmación", overlay = true, max_lines_count = 300, max_labels_count = 300)

len       = input.int(3, "Velas a cada lado", minval = 1)
keep      = input.int(48, "Vigencia del swing (velas)", minval = 1, tooltip = "48 velas de 5m = 4 horas, como en el backtest")
colHi     = input.color(color.red, "Swing high")
colLo     = input.color(color.teal, "Swing low")
showSweep = input.bool(true, "Marcar barridos")

ph = ta.pivothigh(high, len, len)
pl = ta.pivotlow(low, len, len)

plotshape(not na(ph), "Swing high", shape.triangledown, location.abovebar, colHi, offset = -len, size = size.tiny)
plotshape(not na(pl), "Swing low", shape.triangleup, location.belowbar, colLo, offset = -len, size = size.tiny)

type Swing
    line  ln
    float price
    int   bar
    bool  isHigh

var array<Swing> swings = array.new<Swing>()

if not na(ph)
    b = bar_index - len
    swings.push(Swing.new(line.new(b, ph, bar_index, ph, color = colHi, style = line.style_dotted), ph, b, true))
if not na(pl)
    b = bar_index - len
    swings.push(Swing.new(line.new(b, pl, bar_index, pl, color = colLo, style = line.style_dotted), pl, b, false))

if swings.size() > 0
    for i = swings.size() - 1 to 0
        s = swings.get(i)
        s.ln.set_x2(bar_index)
        swept = s.isHigh ? high > s.price : low < s.price
        if swept
            s.ln.set_style(line.style_solid)
            if showSweep
                label.new(bar_index, s.price, "barrido", color = color.new(color.white, 100),
                          textcolor = s.isHigh ? colHi : colLo, size = size.small,
                          style = s.isHigh ? label.style_label_down : label.style_label_up)
            alert((s.isHigh ? "Barrido de swing HIGH " : "Barrido de swing LOW ") + str.tostring(s.price, format.mintick)
                  + " en " + syminfo.ticker + " — buscar CISD", alert.freq_once_per_bar)
            swings.remove(i)
        else if bar_index - s.bar > keep
            s.ln.set_color(color.new(s.isHigh ? colHi : colLo, 70))
            swings.remove(i)
