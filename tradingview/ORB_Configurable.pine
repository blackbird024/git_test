//@version=6
// ─────────────────────────────────────────────────────────────────────────────────────────────
// ORB configurable · MNQ / NQ — estrategia de TradingView con las mismas opciones que describe la guía pública
// "ORB El Autómata": rango en hora de NY, entrada al cierre de una vela fuera del rango (o al toque con orden stop),
// stop en la mecha / cuerpo / lado opuesto con mínimo y máximo, objetivo en R o en puntos, tamaño fijo, por riesgo en $
// o por % de la cuenta, límite de operaciones por sesión, parar tras ganar o perder y rearme.
// Resultado en el laboratorio (laboratorio/run_orb_automata.py, exp. 20261015_163023, MNQ 2018-2026, 1 op/sesión):
//   NINGUNA de 32 configuraciones gana en 2018-21 y 2022-24 a la vez. Los buenos números de la guía son de 90 días / 1 año.
//   Úsalo para PROBAR configuraciones (cambia las fechas del probador a 2019-2021) y en SIMULACIÓN, no como garantía.
// Gráfico recomendado: MNQ1! en 1 o 5 minutos (el horario del rango tiene que coincidir con el inicio y el final de velas).
// ─────────────────────────────────────────────────────────────────────────────────────────────
strategy("ORB configurable · MNQ", "ORBc", overlay = true, process_orders_on_close = true,
         initial_capital = 50000, default_qty_type = strategy.fixed, default_qty_value = 1,
         commission_type = strategy.commission.cash_per_contract, commission_value = 0.75, slippage = 2,
         max_labels_count = 500, max_lines_count = 500, max_boxes_count = 300)

TZ = "America/New_York"

// ── Horario
G1 = "Horario (hora de Nueva York)"
rangoSess = input.session("0100-0115", "Horario del rango", group = G1, tooltip = "Máximo y mínimo de estas velas. Ej.: 0100-0115 (madrugada) o 0915-0930 (antes de la apertura).")
entrySess = input.session("0115-0400", "Ventana para abrir operaciones", group = G1)
cierreHM  = input.int(500, "Cierre obligatorio (HHMM)", minval = 0, maxval = 2359, group = G1, tooltip = "A esta hora se cierra todo, pase lo que pase. Ej.: 500 = 5:00 NY.")

// ── Entrada
G2 = "Entrada"
modoEnt   = input.string("Cierre fuera", "Tipo de entrada", options = ["Cierre fuera", "Toque (orden stop)"], group = G2, tooltip = "Cierre fuera: entra al cierre de la vela que cierra fuera del rango. Toque: órdenes stop OCO 1 tick fuera (el stop va siempre al lado opuesto).")
bufRupt   = input.float(0.0, "Buffer de ruptura (pts)", step = 0.25, group = G2)
velaFavor = input.bool(true, "La vela de ruptura tiene que ser a favor", group = G2)
soloPrim  = input.bool(true, "Solo la primera vela que cierra fuera", group = G2, tooltip = "Si la primera vela que cierra fuera no cumple, no entra (salvo rearme).")

// ── Stop y objetivo
G3 = "Stop y objetivo"
stopModo  = input.string("Lado opuesto", "Dónde va el stop", options = ["Mecha de la vela de ruptura", "Cuerpo de la vela de ruptura", "Lado opuesto"], group = G3)
bufStop   = input.float(0.25, "Buffer del stop (pts)", step = 0.25, group = G3)
minStop   = input.float(0.0, "Stop mínimo (pts)", step = 0.25, group = G3)
maxStop   = input.float(0.0, "Stop máximo (pts, 0 = sin límite)", step = 0.25, group = G3)
maxAcc    = input.string("Omitir la operación", "Si el stop supera el máximo", options = ["Omitir la operación", "Limitar al máximo"], group = G3)
objModo   = input.string("Múltiplo de R", "Objetivo", options = ["Múltiplo de R", "Puntos fijos"], group = G3)
objR      = input.float(1.0, "Objetivo (R)", step = 0.1, group = G3)
objPts    = input.float(20.0, "Objetivo (pts)", step = 0.25, group = G3)

// ── Riesgo y tamaño
G4 = "Riesgo y tamaño"
sizeModo  = input.string("Contratos fijos", "Tamaño", options = ["Contratos fijos", "Riesgo fijo en $", "% de la cuenta"], group = G4)
qtyFija   = input.int(1, "Contratos fijos", minval = 1, group = G4)
riskUsd   = input.float(150.0, "Riesgo por operación ($)", step = 5, group = G4)
riskPct   = input.float(0.5, "Riesgo por operación (% de la cuenta)", step = 0.1, group = G4)
maxQty    = input.int(10, "Máximo de contratos", minval = 1, group = G4)
ptVal     = input.float(2.0, "$ por punto (MNQ 2 · NQ 20)", group = G4)

// ── Disciplina
G5 = "Disciplina"
maxOps    = input.int(1, "Operaciones por sesión", minval = 1, group = G5)
paraGana  = input.bool(true, "Parar después de ganar", group = G5)
paraPierde = input.bool(false, "Parar después de perder", group = G5)
rearme    = input.bool(false, "Rearme: volver a buscar si el precio regresa al rango", group = G5)

// ── Visualización
G6 = "Visualización"
verPanel  = input.bool(true, "Panel", group = G6)
colRng    = input.color(color.new(#C9A227, 80), "Rango", group = G6)
colL      = input.color(#26A69A, "Largo / objetivo", group = G6)
colS      = input.color(#EF5350, "Corto / stop", group = G6)

tick = syminfo.mintick
enRango = not na(time(timeframe.period, rangoSess, TZ))
enEntr  = not na(time(timeframe.period, entrySess, TZ))
hmClose = hour(time_close, TZ) * 100 + minute(time_close, TZ)

var float rHi = na
var float rLo = na
var bool  listo = false
var int   ops = 0
var bool  parado = false
var bool  armado = true
var box   bx = na

// ── Rango
if enRango and not enRango[1]
    rHi := high
    rLo := low
    listo := false
    ops := 0
    parado := false
    armado := true
    bx := box.new(bar_index, high, bar_index, low, border_color = colRng, bgcolor = colRng)
else if enRango
    rHi := math.max(rHi, high)
    rLo := math.min(rLo, low)
    box.set_top(bx, rHi)
    box.set_bottom(bx, rLo)
    box.set_right(bx, bar_index)
if not enRango and enRango[1]
    listo := true
if listo and not na(bx) and enEntr
    box.set_right(bx, bar_index)

// ── Contar operaciones y resultados
if strategy.position_size != 0 and strategy.position_size[1] == 0
    ops += 1
if strategy.closedtrades > strategy.closedtrades[1]
    float pnlUlt = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if (pnlUlt > 0 and paraGana) or (pnlUlt < 0 and paraPierde)
        parado := true

// ── Rearme
if not armado and rearme and close <= rHi and close >= rLo
    armado := true

puede = listo and enEntr and strategy.position_size == 0 and ops < maxOps and not parado and armado and hmClose < cierreHM

tamano(float dist) =>
    float q = sizeModo == "Contratos fijos" ? qtyFija : sizeModo == "Riesgo fijo en $" ? math.floor(riskUsd / (dist * ptVal)) : math.floor(strategy.equity * riskPct / 100 / (dist * ptVal))
    math.min(q, maxQty)

// ── Entrada al cierre de la vela
if modoEnt == "Cierre fuera" and puede
    bool fueraL = close > rHi + bufRupt
    bool fueraS = close < rLo - bufRupt
    bool okL = fueraL and (not velaFavor or close > open)
    bool okS = fueraS and (not velaFavor or close < open)
    if (fueraL or fueraS) and not (okL or okS) and soloPrim
        armado := false
    if okL or okS
        int sd = okL ? 1 : -1
        float stopPx = stopModo == "Mecha de la vela de ruptura" ? (sd == 1 ? low : high) : stopModo == "Cuerpo de la vela de ruptura" ? (sd == 1 ? math.min(open, close) : math.max(open, close)) : (sd == 1 ? rLo : rHi)
        stopPx := stopPx - sd * bufStop
        float dist = math.max(sd * (close - stopPx), minStop)
        bool omitir = false
        if maxStop > 0 and dist > maxStop
            if maxAcc == "Omitir la operación"
                omitir := true
            else
                dist := maxStop
        float q = tamano(dist)
        if omitir or q < 1
            armado := false
        else
            float stp = math.round_to_mintick(close - sd * dist)
            float tgt = math.round_to_mintick(close + sd * (objModo == "Múltiplo de R" ? objR * dist : objPts))
            string msg = (sd == 1 ? "ORBc LARGO " : "ORBc CORTO ") + str.tostring(q) + " · stop " + str.tostring(stp) + " · objetivo " + str.tostring(tgt)
            if sd == 1
                strategy.entry("L", strategy.long, q, alert_message = msg)
                strategy.exit("XL", "L", stop = stp, limit = tgt, alert_message = "ORBc salida largo")
            else
                strategy.entry("S", strategy.short, q, alert_message = msg)
                strategy.exit("XS", "S", stop = stp, limit = tgt, alert_message = "ORBc salida corto")
            label.new(bar_index, sd == 1 ? low : high, (sd == 1 ? "▲ " : "▼ ") + str.tostring(q) + "\nstop " + str.tostring(stp) + "\nobj " + str.tostring(tgt),
                      style = sd == 1 ? label.style_label_up : label.style_label_down, size = size.small,
                      color = sd == 1 ? colL : colS, textcolor = color.white)

// ── Entrada al toque (órdenes stop OCO; stop en el lado opuesto)
if modoEnt == "Toque (orden stop)"
    if puede
        float dist = math.max(rHi - rLo + 2 * tick + bufStop, minStop)
        bool omitir = maxStop > 0 and dist > maxStop and maxAcc == "Omitir la operación"
        if maxStop > 0 and dist > maxStop and not omitir
            dist := maxStop
        float q = tamano(dist)
        if not omitir and q >= 1
            float eL = rHi + tick
            float eS = rLo - tick
            float tL = objModo == "Múltiplo de R" ? objR * dist : objPts
            strategy.entry("L", strategy.long, q, stop = eL, oca_name = "orb", oca_type = strategy.oca.cancel, alert_message = "ORBc LARGO al toque")
            strategy.entry("S", strategy.short, q, stop = eS, oca_name = "orb", oca_type = strategy.oca.cancel, alert_message = "ORBc CORTO al toque")
            strategy.exit("XL", "L", stop = math.round_to_mintick(eL - dist), limit = math.round_to_mintick(eL + tL), alert_message = "ORBc salida largo")
            strategy.exit("XS", "S", stop = math.round_to_mintick(eS + dist), limit = math.round_to_mintick(eS - tL), alert_message = "ORBc salida corto")
    else if strategy.position_size == 0
        strategy.cancel("L")
        strategy.cancel("S")

// ── Cierre obligatorio
if hmClose >= cierreHM
    if strategy.position_size != 0
        strategy.close_all(comment = "cierre por hora", alert_message = "ORBc cierre por hora")
    strategy.cancel_all()

// ── Panel
var table tb = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 20), border_width = 1)
if verPanel and barstate.islast
    int nT = strategy.closedtrades
    int nW = strategy.wintrades
    table.cell(tb, 0, 0, "ORB configurable", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, rangoSess + " NY", text_color = color.gray, text_size = size.small)
    table.cell(tb, 0, 1, "Operaciones", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 1, str.tostring(nT), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 2, "Acierto", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 2, nT > 0 ? str.tostring(100.0 * nW / nT, "#.#") + " %" : "—", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 3, "Neto", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 3, str.tostring(strategy.netprofit, "#") + " $", text_color = strategy.netprofit >= 0 ? colL : colS, text_size = size.small)
    table.cell(tb, 0, 4, "Peor caída", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 4, str.tostring(-strategy.max_drawdown, "#") + " $", text_color = colS, text_size = size.small)
