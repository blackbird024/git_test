//@version=6
// ─────────────────────────────────────────────────────────────────────────────────────────────
// Oro · ruptura del rango de NY de ayer en la sesión de Londres (MGC1! / GC1!, gráfico de 5 min)
// Mismas reglas que alpaca/liquidez_ruptura_london.py:
//   1. Rango = máximo y mínimo de la sesión de NY de ayer (9:30-16:00 NY = 15:30-22:00 Italia).
//   2. A las 08:00 Londres (09:00 Italia), si el precio está DENTRO del rango:
//      compra STOP en el máximo y venta STOP en el mínimo; la primera que entra, una al día.
//   3. Stop en el otro lado del rango. Objetivo: 1 rango completo más allá del nivel.
//   4. Entradas hasta las 12:00 Londres (13:00 Italia). Salida forzosa a las 16:00 NY (22:00 Italia)
//      o, si se elige, a las 14:25 Londres (15:25 Italia).
//   5. FILTRO (activado por defecto): solo compras si el precio a las 08:00 Londres está POR DEBAJO de la media de
//      20 cierres diarios; solo ventas si está POR ENCIMA. Si el precio rompe primero el lado no permitido, hoy no se opera.
// Backtest oro 2018-2026 (1 MGC, coste 0,3 puntos), salida 14:25 Londres:
//   sin filtro ~75 ops/año, 48 % · 2018-22 +400 $/año · 2023-26 +1.430 $/año · peor racha −1.270 $ · 6/9 años +
//   con filtro ~32 ops/año, 51 % · 2018-22 +420 $/año (PF 1,47) · 2023-26 +1.330 $/año (PF 2,25) · peor racha −620 $ · 8/9 años +
//   (el filtro salió de probar ~100 combinaciones: confírmalo en replay o con 1 micro antes de confiar del todo)
// Si stop y objetivo caen en la misma vela, el indicador cuenta el stop (igual que el backtest).
// ─────────────────────────────────────────────────────────────────────────────────────────────
indicator("Oro · Londres · rango NY de ayer", "Oro Londres", overlay = true, max_labels_count = 500, max_boxes_count = 500, max_lines_count = 500)

TZN = "America/New_York"
TZL = "Europe/London"
exitMode  = input.string("14:25 Londres (15:25 Italia)", "Salida", options = ["14:25 Londres (15:25 Italia)", "16:00 NY (22:00 Italia)"])
useFilter = input.bool(true, "Filtro: ruptura en contra de la media de 20 días")
tgtMult   = input.float(1.0, "Objetivo (× rango)", step = 0.25)
lastEntry = input.int(1200, "Última entrada (HHMM Londres)")
ptVal     = input.float(10.0, "$ por punto (MGC 10 · GC 100)")
showPanel = input.bool(true, "Panel")
colLvl    = input.color(#C9A227, "Rango de NY de ayer")
colUp     = input.color(#26A69A, "Largo / objetivo")
colDn     = input.color(#EF5350, "Corto / stop")

fmt(float x) => str.tostring(x, format.mintick)
sma20 = request.security(syminfo.tickerid, "D", ta.sma(close, 20)[1], lookahead = barmerge.lookahead_on)   // media de los 20 cierres anteriores
usd(float pts) => str.tostring(pts * ptVal, "#") + " $"

inNY    = not na(time(timeframe.period, "0930-1600", TZN))
nyStart = inNY and not inNY[1]
nyEnd   = not inNY and inNY[1]
lt      = hour(time, TZL) * 100 + minute(time, TZL)
ntC     = hour(time_close, TZN) * 100 + minute(time_close, TZN)
ltC     = hour(time_close, TZL) * 100 + minute(time_close, TZL)
ldnOpen = lt >= 800 and (lt[1] < 800 or lt[1] > lt)
exitBar = exitMode == "16:00 NY (22:00 Italia)" ? (inNY and ntC >= 1600) : (ltC >= 1425 and lt < 1425)

// ── rango de NY (el de hoy pasa a ser «ayer» cuando termina la sesión)
var float curH = na
var float curL = na
var float H = na
var float L = na
if nyStart
    curH := high
    curL := low
else if inNY
    curH := math.max(curH, high)
    curL := math.min(curL, low)
if nyEnd
    H := curH
    L := curL

// ── estado del día
var bool   active = false
var bool   done = true
var int    pos = 0
var float  e = na
var float  sl = na
var float  tg = na
var string st = "—"
var int    allowDir = 0     // con filtro: 1 solo compras · -1 solo ventas · 0 ninguno; sin filtro: 2 los dos
var box    bxT = na
var box    bxS = na
var int    nOps = 0
var int    nWin = 0
var float  sumUsd = 0.0

if ldnOpen and not na(H)
    pos := 0
    done := false
    active := open > L and open < H
    allowDir := not useFilter ? 2 : na(sma20) ? 0 : close[1] < sma20 ? 1 : close[1] > sma20 ? -1 : 0
    if active and allowDir == 0
        active := false
        st := "filtro sin dirección: hoy no se opera"
    else
        st := active ? "esperando ruptura" + (allowDir == 1 ? " · SOLO COMPRAS" : allowDir == -1 ? " · SOLO VENTAS" : "") + " (hasta las " + str.tostring(lastEntry) + " Londres)" : "abrió fuera del rango: hoy no se opera"
    if not active
        done := true
    else
        orders = allowDir == 1 ? "COMPRA STOP " + fmt(H) + " (solo compras; si rompe antes " + fmt(L) + ", hoy no)" : allowDir == -1 ? "VENTA STOP " + fmt(L) + " (solo ventas; si rompe antes " + fmt(H) + ", hoy no)" : "COMPRA STOP " + fmt(H) + " · VENTA STOP " + fmt(L)
        alert("Oro Londres · " + syminfo.ticker + " · " + orders + " · stop en el lado contrario · riesgo " + usd(H - L), alert.freq_once_per_bar)

if pos != 0
    bxT.set_right(bar_index)
    bxS.set_right(bar_index)

if barstate.isconfirmed and not na(H)
    if pos != 0
        hitS = pos == 1 ? low <= sl : high >= sl
        hitT = pos == 1 ? high >= tg : low <= tg
        if hitS or hitT or exitBar
            px = hitS ? (pos == 1 ? math.min(sl, open) : math.max(sl, open)) : hitT ? tg : close
            res = pos * (px - e)
            nOps += 1
            nWin += res > 0.3 ? 1 : 0
            sumUsd += (res - 0.3) * ptVal
            label.new(bar_index, px, (res >= 0 ? "+" : "") + usd(res), style = label.style_label_left, size = size.tiny,
              color = color.new(res > 0 ? colUp : colDn, 15), textcolor = color.white)
            alert("Oro Londres · " + syminfo.ticker + " · " + (hitS ? "STOP" : hitT ? "OBJETIVO" : "cierre por hora") + " · " + usd(res), alert.freq_once_per_bar_close)
            st := (hitS ? "stop" : hitT ? "objetivo" : "cerrado por hora") + " · " + usd(res)
            pos := 0
            done := true
    else if active and not done and lt <= lastEntry and lt >= 800
        up = high > H
        dn = low < L
        if up and dn
            st := "rompió los dos lados en la misma vela: hoy no"
            done := true
        else if (up or dn) and allowDir != 2 and (up ? 1 : -1) != allowDir
            st := "rompió primero el lado no permitido por el filtro: hoy no"
            label.new(bar_index, up ? H : L, "✕ filtro", style = up ? label.style_label_down : label.style_label_up, size = size.tiny,
              color = color.new(color.gray, 30), textcolor = color.white)
            done := true
        else if up or dn
            s = up ? 1 : -1
            R = H - L
            e := up ? math.max(H, open) : math.min(L, open)
            sl := up ? L : H
            tg := (up ? H : L) + s * tgtMult * R
            if (s == 1 and low <= sl) or (s == -1 and high >= sl)
                // la misma vela de entrada toca el stop: pérdida (conservador, como el backtest)
                res = s * (sl - e)
                nOps += 1
                sumUsd += (res - 0.3) * ptVal
                st := "stop en la vela de entrada · " + usd(res)
                done := true
            else
                pos := s
                bxT := box.new(bar_index, math.max(e, tg), bar_index + 1, math.min(e, tg), border_color = color.new(colUp, 40), bgcolor = color.new(colUp, 80))
                bxS := box.new(bar_index, math.max(e, sl), bar_index + 1, math.min(e, sl), border_color = color.new(colDn, 40), bgcolor = color.new(colDn, 84))
                label.new(bar_index, e, s == 1 ? "LARGO" : "CORTO", style = s == 1 ? label.style_label_up : label.style_label_down,
                  yloc = s == 1 ? yloc.belowbar : yloc.abovebar, size = size.tiny, color = s == 1 ? colUp : colDn, textcolor = color.white,
                  tooltip = "Entrada " + fmt(e) + "\nStop " + fmt(sl) + " (" + usd(math.abs(e - sl)) + ")\nObjetivo " + fmt(tg) + " (" + usd(math.abs(tg - e)) + ")")
                alert("Oro Londres · " + syminfo.ticker + " · " + (s == 1 ? "COMPRA " : "VENTA ") + fmt(e) + " · stop " + fmt(sl) + " · objetivo " + fmt(tg), alert.freq_once_per_bar_close)
                st := (s == 1 ? "LARGO " : "CORTO ") + fmt(e) + " · stop " + fmt(sl) + " · obj " + fmt(tg)
    else if active and not done and lt > lastEntry
        st := "sin ruptura antes de las " + str.tostring(lastEntry) + ": hoy no"
        done := true

// ── líneas del rango (visibles desde la apertura de Londres hasta la salida)
brk(float x) => x != x[1] ? float(na) : x
bH = brk(H)
bL = brk(L)
showLvls = lt >= 800 and not inNY
plot(showLvls ? bH : na, "Máximo NY de ayer", colLvl, 2, plot.style_linebr)
plot(showLvls ? bL : na, "Mínimo NY de ayer", colLvl, 2, plot.style_linebr)

// ── panel
var table pnl = table.new(position.top_right, 2, 7, bgcolor = color.new(#0D1117, 8), border_color = color.new(color.gray, 85), border_width = 1)
row(int r, string a, string b) =>
    pnl.cell(0, r, a, text_color = color.new(color.white, 35), text_size = size.small, text_halign = text.align_left)
    pnl.cell(1, r, b, text_color = color.white, text_size = size.small, text_halign = text.align_left)
if showPanel and barstate.islast
    row(0, "Compra stop", na(H) ? "—" : fmt(H))
    row(1, "Venta stop", na(L) ? "—" : fmt(L))
    row(2, "Riesgo / objetivo", na(H) ? "—" : usd(H - L) + " / " + usd(tgtMult * (H - L)))
    row(3, "Salida", exitMode)
    row(4, "Hoy", st)
    row(5, "Filtro (media 20 días)", not useFilter ? "desactivado" : na(sma20) ? "—" : (close < sma20 ? "precio debajo → solo COMPRAS" : "precio encima → solo VENTAS"))
    row(6, "En este gráfico", nOps == 0 ? "—" : str.tostring(nOps) + " ops · " + str.tostring(100.0 * nWin / nOps, "#") + " % · " + str.tostring(sumUsd, "#") + " $")
