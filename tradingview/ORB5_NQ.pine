//@version=6
// ─────────────────────────────────────────────────────────────────────────────────────────────
// ORB 5 min con «la vela habla» · NQ / MNQ (sesión regular de NY) — alpaca/orb_vela_previa.py y orb_ratio.py
//   1. Vela previa: 9:25-9:30 NY (15:25-15:30 Italia). Se marcan su máximo y su mínimo.
//   2. Primera vela de NY: 9:30-9:35 (15:30-15:35 Italia).
//        verde que CIERRA por encima del máximo de la previa → COMPRA a las 9:35
//        roja que CIERRA por debajo del mínimo de la previa → VENTA a las 9:35   · stop 10 % del ATR
//   3. Si no rompe la previa → se mira la vela de 15 min (9:30-9:45): si su mecha en contra es MENOR que su cuerpo
//      → entrada a las 9:45 en su color, stop 15 % del ATR. Si no → hoy no se opera.
//   4. Sin objetivo: cierre a las 16:00 NY (22:00 Italia). Una operación al día.
//   ATR = media del rango (máximo − mínimo) de las últimas 14 sesiones regulares (9:30-16:00 NY).
// Backtest NQ 2018-2026 (1 MNQ, coste 1 punto, todos los días incl. lunes): ~210 ops/año, ~18 % de acierto,
//   2018-22 +2.215 $/año (PF 1,31) · 2023-26 +2.477 $/año (PF 1,23) · peor racha −1.790 $ · 9/9 años positivos.
//   Con objetivo fijo empeora (1:2 ≈ 0). Pierdes ~8 de cada 10: no te saltes días ni cierres antes.
// Úsalo en un gráfico de 1 o 5 minutos de MNQ1! / NQ1!.
// ─────────────────────────────────────────────────────────────────────────────────────────────
indicator("ORB 5 min · NQ · la vela habla", "ORB5", overlay = true, max_labels_count = 500, max_boxes_count = 500)

TZ        = "America/New_York"
stop5     = input.float(0.10, "Stop entrada 9:35 (× ATR)", step = 0.01)
stop15    = input.float(0.15, "Stop entrada 9:45 (× ATR)", step = 0.01)
use15     = input.bool(true, "Segunda opción: vela de 15 min")
atrLen    = input.int(14, "Sesiones para el ATR", minval = 5)
ptVal     = input.float(2.0, "$ por punto (MNQ 2 · NQ 20)")
showPanel = input.bool(true, "Panel")
colUp     = input.color(#26A69A, "Largo")
colDn     = input.color(#EF5350, "Corto / stop")
colBox    = input.color(#C9A227, "Primera vela")
colPre    = input.color(#8A93A6, "Vela previa 9:25")

fmt(float x) => str.tostring(x, format.mintick)
usd(float pts) => str.tostring(pts * ptVal, "#") + " $"

inRth    = not na(time(timeframe.period, "0930-1600", TZ))
rthStart = inRth and not inRth[1]
hm       = hour(time, TZ) * 100 + minute(time, TZ)
hmC      = hour(time_close, TZ) * 100 + minute(time_close, TZ)
lastBar  = inRth and hmC >= 1600
inPre    = hm >= 925 and hm < 930

// ── ATR propio: media de los rangos de las últimas sesiones regulares
var float dH = na
var float dL = na
var array<float> rngs = array.new<float>()
var float atrOwn = na
if rthStart
    if not na(dH)
        rngs.push(dH - dL)
        if rngs.size() > atrLen
            rngs.shift()
    atrOwn := rngs.size() >= atrLen ? rngs.avg() : na
    dH := high
    dL := low
else if inRth
    dH := math.max(dH, high)
    dL := math.min(dL, low)
tkR    = ticker.modify(syminfo.tickerid, session.regular)
atrSec = request.security(tkR, "D", ta.sma(high - low, atrLen)[1], lookahead = barmerge.lookahead_on)

// ── vela previa 9:25-9:30
var float preH = na
var float preL = na
if inPre and not inPre[1]
    preH := high
    preL := low
else if inPre
    preH := math.max(preH, high)
    preL := math.min(preL, low)

// ── estado del día
var float  atrDay = na
var float  op = na
var float  fH = na
var float  fL = na
var int    pos = 0
var int    pend = 0          // dirección pendiente de entrar en la apertura siguiente
var float  pendStop = na
var float  e = na
var float  sl = na
var bool   done = true
var bool   waiting15 = false
var string st = "—"
var box    fb = na
var int    nOps = 0
var int    nWin = 0
var float  sumUsd = 0.0

if rthStart
    atrDay := na(atrOwn) ? atrSec : atrOwn
    op := open
    fH := high
    fL := low
    pos := 0
    pend := 0
    waiting15 := false
    done := na(atrDay) or na(preH)
    st := na(atrDay) ? "sin ATR" : na(preH) ? "sin vela previa (9:25)" : "esperando la vela de 15:30-15:35"
    fb := box.new(bar_index, high, bar_index, low, border_color = color.new(colBox, 30), bgcolor = color.new(colBox, 88))
else if inRth and hm < 945
    fH := math.max(fH, high)
    fL := math.min(fL, low)
    if hm < 935 or waiting15
        fb.set_top(fH)
        fb.set_bottom(fL)
        fb.set_right(bar_index)

if barstate.isconfirmed and inRth and not done
    // entrada pendiente: se abre en esta vela (la primera tras la señal)
    if pend != 0 and pos == 0
        e := open
        sl := e - pend * pendStop
        pos := pend
        pend := 0
        label.new(bar_index, e, pos == 1 ? "LARGO" : "CORTO", style = pos == 1 ? label.style_label_up : label.style_label_down,
          yloc = pos == 1 ? yloc.belowbar : yloc.abovebar, size = size.tiny, color = pos == 1 ? colUp : colDn, textcolor = color.white,
          tooltip = "Entrada " + fmt(e) + "\nStop " + fmt(sl) + " (" + usd(math.abs(e - sl)) + ")\nSin objetivo: cierre 16:00 NY")
        st := (pos == 1 ? "LARGO " : "CORTO ") + fmt(e) + " · stop " + fmt(sl)
    // 9:35: ¿la primera vela rompe la previa?
    if hmC == 935 and pos == 0 and pend == 0 and not waiting15
        s = close > op ? 1 : close < op ? -1 : 0
        brk = (s == 1 and close > preH) or (s == -1 and close < preL)
        if brk
            pend := s
            pendStop := stop5 * atrDay
            st := (s == 1 ? "COMPRA" : "VENTA") + " a mercado 15:35 · rompió la vela de 15:25"
            alert("ORB5 · " + syminfo.ticker + " · " + (s == 1 ? "COMPRA" : "VENTA") + " ahora (rompe la vela de 15:25) · stop " + fmt(pendStop)
              + " pts (" + usd(pendStop) + ") · cierre 22:00", alert.freq_once_per_bar_close)
        else if use15
            waiting15 := true
            st := "no rompió la vela de 15:25 → esperando la vela de 15 min (15:45)"
            alert("ORB5 · " + syminfo.ticker + " · no rompe la previa → espera a las 15:45", alert.freq_once_per_bar_close)
        else
            st := "no rompió la vela de 15:25: hoy no"
            done := true
    // 9:45: vela de 15 min como segunda opción
    else if hmC == 945 and waiting15 and pos == 0 and pend == 0
        waiting15 := false
        s = close > op ? 1 : close < op ? -1 : 0
        body = math.abs(close - op)
        wick = s == 1 ? math.min(op, close) - fL : fH - math.max(op, close)
        if s != 0 and wick < body
            pend := s
            pendStop := stop15 * atrDay
            st := (s == 1 ? "COMPRA" : "VENTA") + " a mercado 15:45 · vela de 15 min sin rechazo"
            alert("ORB5 · " + syminfo.ticker + " · " + (s == 1 ? "COMPRA" : "VENTA") + " ahora (vela de 15 min sin rechazo) · stop " + fmt(pendStop)
              + " pts (" + usd(pendStop) + ") · cierre 22:00", alert.freq_once_per_bar_close)
        else
            st := "vela de 15 min con rechazo: hoy no"
            done := true
            alert("ORB5 · " + syminfo.ticker + " · hoy no se opera", alert.freq_once_per_bar_close)
    // gestión
    if pos != 0
        hitS = pos == 1 ? low <= sl : high >= sl
        if hitS or lastBar
            px = hitS ? (pos == 1 ? math.min(sl, open) : math.max(sl, open)) : close
            res = pos * (px - e)
            nOps += 1
            nWin += res > 1 ? 1 : 0
            sumUsd += (res - 1) * ptVal
            label.new(bar_index, px, (res >= 0 ? "+" : "") + usd(res), style = label.style_label_left, size = size.tiny,
              color = color.new(res > 0 ? colUp : colDn, 15), textcolor = color.white)
            alert("ORB5 · " + syminfo.ticker + " · " + (hitS ? "STOP" : "cierre 22:00") + " · " + usd(res), alert.freq_once_per_bar_close)
            st := (hitS ? "stop · hoy no más" : "cerrado a las 22:00") + " · " + usd(res)
            pos := 0
            done := true

// ── líneas
brk(float x) => x != x[1] ? float(na) : x
showPre = inRth and hm < 1000
plot(showPre ? brk(preH) : na, "Máximo vela 9:25", colPre, 1, plot.style_linebr)
plot(showPre ? brk(preL) : na, "Mínimo vela 9:25", colPre, 1, plot.style_linebr)
plot(pos != 0 ? sl : na, "Stop", colDn, 1, plot.style_linebr)
plot(pos != 0 ? e : na, "Entrada", color.new(color.gray, 30), 1, plot.style_linebr)

// ── panel
var table pnl = table.new(position.top_right, 2, 5, bgcolor = color.new(#0D1117, 8), border_color = color.new(color.gray, 85), border_width = 1)
row(int r, string a, string b) =>
    pnl.cell(0, r, a, text_color = color.new(color.white, 35), text_size = size.small, text_halign = text.align_left)
    pnl.cell(1, r, b, text_color = color.white, text_size = size.small, text_halign = text.align_left)
if showPanel and barstate.islast
    row(0, "ATR sesión", na(atrDay) ? "—" : fmt(atrDay) + " pts" + (na(atrOwn) ? " (diario RTH)" : ""))
    row(1, "Stop 15:35 / 15:45", na(atrDay) ? "—" : usd(stop5 * atrDay) + " / " + usd(stop15 * atrDay))
    row(2, "Vela 15:25", na(preH) ? "—" : "máx " + fmt(preH) + " · mín " + fmt(preL))
    row(3, "Hoy", st)
    row(4, "En este gráfico", nOps == 0 ? "—" : str.tostring(nOps) + " ops · " + str.tostring(100.0 * nWin / nOps, "#") + " % · " + str.tostring(sumUsd, "#") + " $")
