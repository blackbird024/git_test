//@version=6
// RSI(2) de Connors en NQ/MNQ — MODO PAPEL (alertas, no envía órdenes).
// Reglas validadas (ver reports/nq_rsi2.html): largo si RSI(2) < 20 y cierre > SMA(200) al cierre diario;
// entrada en la apertura siguiente; salida tras el cierre en que RSI(2) > 70 o tras 5 sesiones.
// Usar en gráfico DIARIO de NQ1! o MNQ1! con el ajuste de cambios de contrato activado
// (Configuración del gráfico > Símbolo > "Ajustar por cambio de contrato" / back-adjust).
strategy("RSI(2) Connors NQ — papel", overlay = true, default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 1.0, slippage = 2)

umbralEntrada = input.float(20, "RSI(2) de entrada: menor que")
umbralSalida  = input.float(70, "RSI(2) de salida: mayor que")
maxSesiones   = input.int(5, "Máximo de sesiones en la operación")

rsi2   = ta.rsi(close, 2)
sma200 = ta.sma(close, 200)
senal  = close > sma200 and rsi2 < umbralEntrada

if barstate.isconfirmed
    if strategy.position_size == 0 and senal
        strategy.entry("Largo", strategy.long)
        alert("RSI(2) NQ: COMPRAR 1 MNQ en la reapertura. RSI(2)=" + str.tostring(rsi2, "#.0"), alert.freq_once_per_bar_close)
    else if strategy.position_size > 0
        sesiones = bar_index - strategy.opentrades.entry_bar_index(0) + 1
        if rsi2 > umbralSalida or sesiones >= maxSesiones
            strategy.close("Largo")
            alert("RSI(2) NQ: VENDER en la reapertura. RSI(2)=" + str.tostring(rsi2, "#.0") + ", sesiones=" + str.tostring(sesiones), alert.freq_once_per_bar_close)

plot(sma200, "SMA 200", color = color.new(#2a78d6, 0), linewidth = 2)
plotshape(senal and strategy.position_size == 0, "Señal", shape.triangleup, location.belowbar, color.new(#008300, 0), size = size.small)
